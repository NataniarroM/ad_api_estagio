# .env.example  ->  MODELO do arquivo .env
# Como usar:
#   1. Copie este arquivo e renomeie a cópia para ".env" (na raiz do projeto).
#   2. Troque os valores de exemplo pelos seus.
#   3. NUNCA suba o .env para o GitHub (ele já está no .gitignore).

# --- Firebase (autenticação) ---
# Caminho do JSON de credenciais do Firebase (baixado em
# Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada).
# Coloque o arquivo na raiz do projeto. Ele também NÃO vai para o GitHub.
FIREBASE_CREDENTIALS_PATH="firebase_credentials.json"

# Chave de API da Web do Firebase (Firebase > Configurações do projeto > Geral).
# Usada só no login.
FIREBASE_API_KEY="cole-aqui-a-chave-de-api-da-web"

# --- Banco de dados PostgreSQL (usados pelo docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vagas_db

# Conexão da API com o banco. O host "db" é o nome do serviço no docker-compose.
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/vagas_db

# --- Administrador criado automaticamente quando a API liga (ver app/seed.py) ---
# Se o e-mail já existe no Firebase, a senha daqui NÃO muda a senha dele.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NOME=Administrador
ADMIN_SENHA=troque-por-uma-senha-forte
